    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "typescript": "~5.9.0",
    "vue-tsc": "^3.0.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.55.0",
    "fake-indexeddb": "^6.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-vue": "^10.0.0",
